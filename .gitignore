__pycache__/
*.pyc
*.pyo
.venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# raw/ is committed since v0.2 — the versioned source of truth (audit &
# reproducibility). memory/ is committed too. Local editorial working state is
# not: keep-files hold the dirs; the content is ignored.
drafts/*
!drafts/.gitkeep
approved/*
!approved/.gitkeep
published/*
!published/.gitkeep
